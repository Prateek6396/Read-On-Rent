{
  "name": "read-on-rent-backend",
  "version": "1.0.0",
  "description": "Backend REST API for Read on Rent - a book rental platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node src/seeders/seedBooks.js",
    "seed:users": "node src/seeders/seedUsers.js",
    "seed:categories": "node src/seeders/seedCategories.js",
    "seed:all": "npm run seed:categories && npm run seed && npm run seed:users",
    "test": "jest --runInBand"
  },
  "keywords": ["book-rental", "express", "mongodb", "rest-api"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.19.2",
    "mongoose": "^8.5.0",
    "dotenv": "^16.4.5",
    "cors": "^2.8.5",
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.14",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.1.0",
    "morgan": "^1.10.0",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "razorpay": "^2.9.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
