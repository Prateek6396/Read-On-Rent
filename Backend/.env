# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=https://read-on-rent.vercel.app/

# Database — REPLACE this with your real MongoDB Atlas connection string
# (same one you used for MONGODB_URI in Render's Environment tab)
MONGODB_URI=mongodb+srv://readonrent00_db_user:7gHbwoIzyQAxSteu@cluster0.nu5oong.mongodb.net

# JWT — you can leave this or change it to any long random string
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRE=7d

# Email (not required just to seed the admin user — leave blank/default for now)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Payment Gateway (not required just to seed the admin user)
RAZORPAY_KEY_ID=your_razorpay_key
RAZORPAY_KEY_SECRET=your_razorpay_secret

# File Upload
MAX_FILE_SIZE=5242880

# Admin seed credentials — these will be the login you use as admin
ADMIN_EMAIL=admin@readonrent.com
ADMIN_PASSWORD=admin@12345

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
